{
	"name": "fixtures",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"imports": {
		"#lib": "./src/lib",
		"#lib/*": "./src/lib/*",
		"#src/*": "./src/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"start": "CPUS=2 bun build/index.js",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
	},
	"dependencies": {
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"svelte": "^5.56.6"
	},
	"devDependencies": {
		"@tailwindcss/vite": "^4.0.0",
		"svelte-check": "^4.7.0",
		"typescript": "^6",
		"vite": "^8.0.12"
	}
}
