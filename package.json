{
	"name": "@pingpolls/svelte-adapter-bun-isr",
	"version": "1.2.0",
	"description": "SvelteKit adapter for Bun with Incremental Static Regeneration (ISR) support",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/pingpolls/svelte-adapter-bun-isr.git"
	},
	"author": {
		"name": "PingPolls",
		"url": "https://pingpolls.com"
	},
	"contributors": [
		{
			"name": "Azvya Erstevan"
		}
	],
	"keywords": [
		"sveltekit",
		"adapter",
		"bun",
		"ssr",
		"isr",
		"static",
		"svelte"
	],
	"type": "module",
	"main": "dist/index.js",
	"module": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "rm -rf dist && bun build ./src/index.ts --outdir ./dist --target bun --minify && bunx --bun tsc --project tsconfig.build.json",
		"release": "bun run build && bun test && bash scripts/publish.sh"
	},
	"peerDependencies": {
		"@sveltejs/kit": ">=3.0.0"
	},
	"devDependencies": {
		"@sveltejs/kit": "^3.1.0",
		"@types/bun": "~1.4.4",
		"typescript": "^5.9.3",
		"@biomejs/biome": "~2.6.2"
	}
}
